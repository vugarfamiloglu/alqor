// VM: generatorlar — standart arqument, qaytar, gecikdir, bağlama
generator funksiya g(n, ad2 = 2)
    gecikdir yaz("gecikdi")
    dəyişən fs = []
    hər i üçün 0..<n içində
        əgər i == 3 onda qaytar son
        fs.əlavə(() => i * ad2)
        ver fs.çevir((f) => f())
    son
son
hər x üçün g(5) içində
    yaz(x)
son
yaz(g(2, ad2: 10).siyahıyaÇevir())
=====
// VM: generator metodu və xəta
sinif Say
    xassə n: tam = 0
    qurucu(n: tam) özü.n = n son
    generator metod hamısı()
        hər i üçün 1..özü.n içində
            əgər i == 3 onda at Xəta("üç") son
            ver i
        son
    son
son
dəyişən s = Say(5)
cəhd et
    hər x üçün s.hamısı() içində
        yaz(x)
    son
tut e
    yaz("tutuldu", e.mesaj)
son
dəyişən it = Say(2).hamısı()
yaz(it.növbəti(), it.növbəti(), it.bitdi())
=====
// VM: generator içində iç generator və dayan
generator funksiya cüt()
    dəyişən i = 0
    həmişə
        i += 2
        ver i
    son
son
generator funksiya ilk(n)
    dəyişən k = 0
    hər x üçün cüt() içində
        əgər k >= n onda dayan son
        k += 1
        ver x
    son
son
yaz(ilk(4).siyahıyaÇevir(), [x * x üçün x içində ilk(3)])
=====
// VM: ver ifadə kimi və boş ver
generator funksiya f()
    ver boş
    ver 1
    qaytar 5
    ver 2
son
yaz(f().siyahıyaÇevir())

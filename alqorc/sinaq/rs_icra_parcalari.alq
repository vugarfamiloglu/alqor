        hal Ş.Dairə(r) → qaytar 3.14 * r * r
        hal Ş.Düzbucaq(e, h) əgər e == h → qaytar "kvadrat {e * h}"
        hal Ş.Düzbucaq(e, h) → qaytar e * h
    son
son

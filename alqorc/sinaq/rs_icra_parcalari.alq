// VM: dəyişən elanı təkrarı, kortej qaytarma, çoxlu dəyər
funksiya f()
    dəyişən a = 1
    dəyişən a = a + 1
    dəyişən b, c = 3, 4
    dəyişən d = [1, 2]
    qaytar a, b, c, d
son
yaz(f())
dəyişən (p, q, r, s) = f()
yaz(p + q + r)

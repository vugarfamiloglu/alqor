// VM: generator və asinxron funksiyalar
generator funksiya say(n)
    hər i üçün 0..<n içində
        ver i * i
    son
son
yaz(say(4).siyahıyaÇevir())
funksiya cəm(g)
    dəyişən c = 0
    hər x üçün g içində
        c += x
    son
    qaytar c
son
yaz(cəm(say(5)))
=====
// VM: dayan funksiya çağırışından keçir (ağacla eyni davranış)
funksiya f(i)
    əgər i == 2 onda yaz("iki") son
    qaytar i
son
hər i üçün 0..4 içində
    yaz(f(i))
son
təkrarla i, 3 dəfə
    əgər i == 2 onda davam son
    yaz("t", i)
son
=====
// VM: qlobal dəyişənlər, elandan əvvəl oxuma, mənimsətmə xətası
dəyişən x = 10
funksiya f()
    yaz(x)
    dəyişən x = 3
    yaz(x)
    x = 4
    qaytar x
son
funksiya g()
    x = x + 1
son
yaz(f(), x)
g()
yaz(x)
funksiya h()
    y = 1
son
h()
=====
// VM: seç içində dayan/qaytar/davam (ağac icraçısına ötürülən cümlə)
funksiya f(l)
    dəyişən n = []
    hər x üçün l içində
        seç x
            hal 0 → davam
            hal 9 → dayan
            hal 7 → qaytar "yeddi"
            digər hallarda → n.əlavə(x)
        son
    son
    qaytar n
son
yaz(f([1, 0, 2, 9, 3]), f([1, 7, 2]))
=====
// VM: yuxarı səviyyə dövrləri və bağlamalar
dəyişən fs = []
dəyişən cəm = 0
hər i üçün 1..5 içində
    dəyişən kv = i * i
    cəm += kv
    fs.əlavə(() => kv + cəm)
son
yaz(cəm, fs.çevir((f) => f()))
dəyişən i = 0
nə qədər ki i < 3
    i += 1
son
yaz(i)

// VM: xəta yerləri
funksiya f(a)
    əgər a onda yaz("?") son
son
cəhd et
    f(1)
tut e
    yaz(e.tip, e.mesaj)
son
funksiya g(l)
    qaytar l[5]
son
g([1, 2])
=====
// VM: nəhayət içində davam, iç-içə cəhd
funksiya f()
    dəyişən n = []
    hər i üçün 0..5 içində
        cəhd et
            cəhd et
                əgər i % 2 == 0 onda at Xəta("cüt {i}") son
                n.əlavə(i)
            tut e əgər i == 4
                n.əlavə("dörd")
            nəhayət
                n.əlavə("n{i}")
            son
        tut e
            n.əlavə(e.mesaj)
            davam
        son
        n.əlavə("son{i}")
    son
    qaytar n
son
yaz(f())
=====
// VM: struktur kopyası, artırma, mürəkkəb mənimsətmə
struktur N
    xassə x: tam = 0
son
funksiya f()
    dəyişən a = N(x: 1)
    dəyişən b = a
    b.x += 5
    dəyişən l = [a, b]
    l[0].x++
    dəyişən s = 0
    s++
    s -= 3
    dəyişən d = {"k": 1}
    d["k"] *= 7
    dəyişən t = "a"
    t += "b"
    qaytar [a.x, b.x, l[0].x, s, d, t]
son
yaz(f())
=====
// VM: onluq genişlənməsi, tip yoxlama, çevirmə
funksiya f(x: onluq, y)
    dəyişən z: onluq = 3
    qaytar [x, z, y tipidir tam, y tipidir mətn, y kimi mətn, "12" kimi tam, "x" kimi? tam]
son
yaz(f(2, 5))
sinif A son
funksiya g(o) qaytar o tipidir A son
yaz(g(A()), g(1))
=====
// VM: dilim, diapazon, üzvlük, boş yoxlama
funksiya f(l, s)
    qaytar [l[1..3], l[..<2], s[2..], 3 içindədir l, l?.uzunluq(), boş ?? 5, 0..10 addım 3]
son
yaz(f([1, 2, 3, 4, 5], "salam"))
funksiya g()
    hər i üçün 10..0 addım -3 içində
        yaz(i)
    son
son
g()

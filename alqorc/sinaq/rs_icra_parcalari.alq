=====
sinif A
    xassə x: tam = 5
    statik xassə say: tam = 0
    qurucu(x: tam)
        özü.x = x
        A.say += 1
    son
    metod göstər() qaytar "A({özü.x})" son
    statik metod yarat() qaytar A(9) son
son
sinif B miras A
    xassə y = "y"
    qurucu(x: tam, y: mətn)
        üst(x)
        özü.y = y
    son
    əvəz et metod göstər() qaytar "B:" + üst.göstər() son
son
dəyişən b = B(1, "z")
yaz(b.göstər(), A.yarat().göstər(), A.say, b)
yaz(b tipidir A, tip(b), tip(A))

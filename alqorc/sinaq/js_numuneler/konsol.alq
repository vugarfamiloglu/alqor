// konsol modulu — Python ilə eyni çıxış (giriş: test_js)
gətir konsol
yaz(konsol.yaşıl("ok"), konsol.rəng("x", ön: "mavi", qalın: doğru))
dəyişən ad = konsol.soruş("Ad? ", standart: "Dünya")
yaz("Salam, " + ad)
dəyişən r = konsol.seç("Rəng:", ["qırmızı", "mavi"])
yaz(r)
yaz(konsol.təsdiqlə("Davam?", doğru))
yaz(konsol.çoxSeç("Hansı?", ["a", "b", "c"]))
konsol.cədvəl(["Ad", "Yaş"], [["Əli", 30], ["Leyla", 7]])
dəyişən i = konsol.irəliləyiş(8, "Yük")
i.artır(1)
yaz(i.mətnƏt())
i.bitir()
dəyişən f = konsol.fırlanan("İşlənir")
f.dayandır("Hazır")
yaz(konsol.ölçü())

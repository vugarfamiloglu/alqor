{
  "name": "alqor",
  "displayName": "Alqor",
  "description": "Alqor proqramlaşdırma dili: sintaksis rəngləmə, xətalar, tamamlama, təyinata keçid, ad dəyişmə, formatlama, sazlama",
  "version": "2.5.1",
  "publisher": "alqor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vugarfamiloglu/alqor"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "alqor",
        "aliases": [
          "Alqor",
          "alqor"
        ],
        "extensions": [
          ".alq",
          ".alqor"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./alqor-fayl.svg",
          "dark": "./alqor-fayl.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "alqor",
        "scopeName": "source.alqor",
        "path": "./syntaxes/alqor.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Alqor",
      "properties": {
        "alqor.serverƏmri": {
          "type": "string",
          "default": "",
          "markdownDescription": "Dil serverini işə salan əmr. Boşdursa `alqor` (Windows-da `alqor.cmd`) PATH-dan götürülür. Nümunə: `C:\\alqor\\alqor.cmd` və ya `python3 /yol/alqorc/alqorc.py`."
        },
        "alqor.tipRejimi": {
          "type": "string",
          "enum": [
            "sərbəst",
            "normal",
            "sərt"
          ],
          "default": "normal",
          "description": "Tip yoxlamasının sərtliyi (faylda `// alqor: tip sərt` direktivi üstünlük təşkil edir)."
        }
      }
    },
    "commands": [
      {
        "command": "alqor.serveriYenidənBaşlat",
        "title": "Alqor: Dil serverini yenidən başlat"
      }
    ],
    "breakpoints": [
      {
        "language": "alqor"
      }
    ],
    "debuggers": [
      {
        "type": "alqor",
        "label": "Alqor",
        "languages": [
          "alqor"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "İşlədiləcək .alq faylı",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Proqramın arqumentləri",
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "İlk cümlədə dayan",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "alqor",
            "request": "launch",
            "name": "Alqor: cari faylı işlət",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Alqor: faylı sazla",
            "body": {
              "type": "alqor",
              "request": "launch",
              "name": "Alqor: cari faylı işlət",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "icon": "ikon.png",
  "galleryBanner": {
    "color": "#1e3a8a",
    "theme": "dark"
  }
}

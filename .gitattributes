# Bütün mənbə faylları UTF-8 və LF olmalıdır — Azərbaycan hərfləri üçün kritik
*           text=auto eol=lf
*.md        text eol=lf
*.py        text eol=lf
*.alqor     text eol=lf
*.alq       text eol=lf
*.ebnf      text eol=lf
*.toml      text eol=lf

# Windows skriptləri CRLF olmalıdır (cmd.exe LF ilə səhv işləyir)
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.sh text eol=lf
alqor text eol=lf
